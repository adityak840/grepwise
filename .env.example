DATABASE_URL=postgresql://grepwise:grepwise@localhost:5432/grepwise
GEMINI_API_KEY=
EMBEDDER=local         # local (open-source model on this machine, no quota) | gemini | fake
LOCAL_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
# MODEL_CACHE_DIR=~/.cache/grepwise/fastembed   # where the local model is downloaded
EMBEDDING_DIM=768

# Only used when EMBEDDER=gemini (free tier: ~1,000 chunks/day, 100/min).
EMBEDDING_MODEL=gemini-embedding-001
EMBED_TOKENS_PER_MINUTE=20000
SEARCH_CANDIDATES=50            # results taken from each of vector and keyword search
SEARCH_TOKEN_BUDGET=4000        # max (estimated) tokens of results returned
TOOL_MAX_CHARS=12000            # hard cap on every tool output (JSON characters)
READ_MAX_LINES=200              # most lines read_file returns per call

# Host port for the Docker Postgres (docker-compose.yml). Change it, and
# DATABASE_URL above, if something else already uses 5432.
POSTGRES_PORT=5432

# The agent's LLM (M4). Both speak the OpenAI chat API.
LLM_PROVIDER=gemini            # gemini | ollama
LLM_MODEL=                     # default: gemini-3.5-flash-lite (gemini) / grepwise-qwen3.5 (ollama, `make ollama`)
LLM_BASE_URL=                  # optional; defaults per provider
LLM_API_KEY=                   # optional; defaults to GEMINI_API_KEY for gemini
LLM_REASONING_EFFORT=          # optional: none | low | medium | high (default: none for ollama)
AGENT_MAX_STEPS=8
AGENT_MAX_INPUT_TOKENS=60000
AGENT_MAX_TOOL_CALLS_PER_STEP=4

# HTTP API (grepwise serve)
CHAT_RATE_PER_MINUTE=3          # per client IP
CHAT_RATE_PER_DAY=10            # per client IP
CHAT_GLOBAL_PER_DAY=100         # shared by the whole site; keep under the LLM daily allowance
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false      # true only behind a proxy that sets X-Forwarded-For (Render)
