# Every setting is optional. Real environment variables win over this file.
# Grepwise only reads GREPWISE_* names, so it never picks up a project's own settings.

# GREPWISE_HOME=~/.grepwise                 # the database (grepwise.db) and the embedding model
# GREPWISE_EMBEDDER=local                   # local | fake (tests)
# GREPWISE_LOCAL_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
# GREPWISE_SEARCH_CANDIDATES=50             # results taken from each of vector and keyword search
# GREPWISE_SEARCH_TOKEN_BUDGET=4000         # max (estimated) tokens of search results returned
# GREPWISE_TOOL_MAX_CHARS=12000             # hard cap on every tool output (JSON characters)
# GREPWISE_READ_MAX_LINES=200               # most lines read_file returns per call
